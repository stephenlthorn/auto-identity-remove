.git
.github
.claude
**/*.md
**/test/
docs/
**/*.test.js

# Anything below can carry PII or secrets. `COPY . .` runs after npm ci, so an
# entry missing here is baked into an image layer and travels with the image if
# it is ever pushed to a registry or shared as a tar.
config.json
config.json.enc
state.json
state.json.bak
state.json.checkpoint
state.json.checkpoint.tmp
state.json.tmp
state.json.lock
config.json.tmp
config.json.enc.tmp
state.json.bak.tmp
state.json.corrupt-*
state.json.bak.corrupt-*
confirm-processed.json
confirm-processed.json.*.tmp
last-run.json
last-run.json.*.tmp
config.json.bak
config.json.enc.bak
config.json.unreadable-*.bak
config.json.enc.unreadable-*.bak
dashboard/.auth.json
aidr-home/
**/*.passphrase
inbox/
logs
logs/
*.log
data/serp-history.json
data/exposure-history.json
data/exposure-history.json.bak
data/breach-result.json
data/*.tmp
serp-history.json
.env
.env.*
.DS_Store

# TLS material (e.g. an exported Proton Mail Bridge cert/key for SMTP)
*.pem
